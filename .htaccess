RewriteEngine On

# Empêche les navigateurs et proxys de garder en cache une ancienne version
# des fichiers JS/CSS : ça évite qu'une correction déployée côté serveur
# n'atteigne jamais certains utilisateurs (cause du bug "mon équipe à 0" qui
# revenait après avoir déjà été corrigé).
<IfModule mod_headers.c>
    <FilesMatch "\.(js|css)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
    <FilesMatch "\.(html)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>
